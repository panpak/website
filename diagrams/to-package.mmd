flowchart TD
  classDef piano stroke-dasharray:5 4,fill:#fff8e6,stroke:#c9a227,color:#333
  classDef fatto fill:#e7f1fb,stroke:#7aa7d9,color:#123
  classDef dom fill:#f4f4f4,stroke:#999,color:#222
  A["Source code and existing build"]:::fatto --> B{"Who writes the recipe?"}:::dom
  B -->|"the author"| C["Recipe in the app's repository<br/>author's id and key"]:::fatto
  B -->|"a curator"| D["Recipe in the community collection<br/>curator's own id and key<br/>Packaged by X, not by the author"]:::piano
  C --> E["panpak init proposes build system,<br/>executable and metadata"]:::fatto
  D --> E
  E --> F["Lockfile: sources, profile<br/>and build environment"]:::fatto
  F --> G["Local or CI build"]:::fatto
  G --> H["Check libraries and report plug-ins"]:::fatto
  H -.-> T["panpak trace proposes permissions"]:::piano
  H --> I["Test a real task inside the sandbox"]:::fatto
  T --> I
  I --> J{"Does it work with the<br/>declared permissions?"}:::dom
  J -->|"no"| K["Update the recipe"]:::fatto
  K --> G
  J -->|"yes"| L["The publisher confirms<br/>permissions and changes"]:::fatto
  L --> M["Signed by the publisher"]:::fatto
  M --> N[".panpak package with release history,<br/>SBOM and module report"]:::fatto
  N --> O["New upstream release"]:::dom
  O --> P["panpak diff: new permissions,<br/>new libraries and plug-ins"]:::piano
  P --> K
